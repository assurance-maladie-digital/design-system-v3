{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": false,
    "declaration": true,
    "declarationDir": "./dist/src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tests/*": [
        "./tests/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.json",
    "package.json",
    "src/vuetifyConfig.ts"
  ],
  "exclude": [
    "**/*.cy.ts",
    "cypress/**/*",
    "tests/**",
    "**/__tests__/**",
    "**/*.fixture.vue",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}