{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "types": [
      "cypress"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cypress.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.json",
    "tests/**/*",
    "package.json",
    "cypress.config.ts",
    "cypress/**/*.ts"
  ],
  "exclude": []
}
