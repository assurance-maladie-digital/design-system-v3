            ></i>
          </button>
        </div>
        <div
          aria-live="polite"
          class="v-input__details"
          id="input-v-4-messages"
          role="alert"
        >
          <transition-group-stub
            appear="false"
            class="v-messages"
            css="true"
            name="slide-y-transition"
            persisted="false"
            tag="div"
          >
            <div class="v-messages__message">
              Format JJ/MM/AAAA
            </div>
          </transition-group-stub>
          <!---->
        </div>
      </div>
      <!-- v-if -->
    </div>
  </div>
  <!---->
  <!---->
</div>
`;
